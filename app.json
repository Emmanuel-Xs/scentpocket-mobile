{
  "expo": {
    "name": "Scentpocket",
    "slug": "scentpocket-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "scentpocket",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FAF6EF",
    "android": {
      "package": "ng.com.scentpocket",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FAF6EF"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF6EF",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d3279573-0003-4b9f-9f01-612a5cf04c11"
      }
    },
    "owner": "n99plusones-team"
  }
}
